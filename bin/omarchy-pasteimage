#!/bin/bash
# pasteimage — image-aware universal paste for Omarchy.
#
# Omarchy's stock "Universal paste" (SUPER+V) sends Shift+Insert whenever the
# focused window carries Hyprland's `terminal` tag. Terminals implement
# Shift+Insert as paste_from_clipboard, which is text-only, so pasting an image
# into a TUI is a silent no-op. This routes those to Ctrl+V instead, which
# terminals pass straight through to the running program — Claude Code and
# friends then read the image off the clipboard themselves.
#
# Keystrokes are injected with Hyprland's own send_key_state dispatcher rather
# than wtype: a physically-held SUPER merges into a wtype-injected chord at the
# seat, which would turn our Ctrl+V into SUPER+CTRL+V (the clipboard manager).
# See /usr/share/omarchy/default/hypr/bindings/clipboard.lua.

set -uo pipefail

# Hyprland tags terminals in default/hypr/apps/terminals.lua. Dynamic tags carry
# a trailing "*", hence the strip.
is_terminal() {
  hyprctl -j activewindow 2>/dev/null |
    jq -e '[.tags[]? | sub("\\*$"; "")] | index("terminal")' >/dev/null 2>&1
}

has_image() {
  wl-paste --list-types 2>/dev/null | grep -qE '^image/'
}

# $1=mods $2=key. The down/up split works around send_shortcut sometimes leaving
# synthetic key state stuck or repeating (hyprwm/Hyprland#14099).
send_key() {
  local mods=$1 key=$2
  hyprctl dispatch \
    "hl.dsp.send_key_state({ mods = \"$mods\", key = \"$key\", state = \"down\" })" >/dev/null
  sleep 0.05
  hyprctl dispatch \
    "hl.dsp.send_key_state({ mods = \"$mods\", key = \"$key\", state = \"up\" })" >/dev/null
}

# SUPER+V. Preserves stock behaviour everywhere except the case it exists to fix:
# a terminal holding an image, which gets Ctrl+V so the TUI can claim it.
cmd_paste() {
  if is_terminal && ! has_image; then
    send_key SHIFT Insert
  else
    send_key CTRL V
  fi
}

# Called by the cloned clipboard overlay for image rows. Puts the chosen image on
# the clipboard first, then pastes it — the sleep lets the overlay close and focus
# return to the window underneath.
cmd_paste_entry() {
  local mime=${1:-} path=${2:-}

  if [[ -z $mime || -z $path ]]; then
    echo "usage: omarchy-pasteimage paste-entry <mime-type> <path>" >&2
    return 1
  fi
  [[ -r $path ]] || { echo "omarchy-pasteimage: cannot read $path" >&2; return 1; }

  wl-copy --type "$mime" <"$path" || return 1
  sleep 0.15
  send_key CTRL V
}

cmd_check() {
  local missing=0 dep
  for dep in hyprctl jq wl-paste wl-copy; do
    if command -v "$dep" >/dev/null; then
      echo "  ok       $dep"
    else
      echo "  MISSING  $dep" >&2
      missing=1
    fi
  done

  echo
  if is_terminal; then
    echo "  focused window: terminal (would use Ctrl+V for images)"
  else
    echo "  focused window: not a terminal (always Ctrl+V)"
  fi

  local types
  types=$(wl-paste --list-types 2>/dev/null | tr '\n' ' ')
  echo "  clipboard types: ${types:-<empty>}"
  if has_image; then
    echo "  clipboard holds an image -> SUPER+V will send Ctrl+V"
  else
    echo "  clipboard holds no image -> SUPER+V pastes as usual"
  fi

  return $missing
}

usage() {
  cat <<'USAGE'
Usage: omarchy-pasteimage <command>

  paste                          Image-aware universal paste. Bind to SUPER+V.
  paste-entry <mime> <path>      Copy a file to the clipboard and paste it.
                                 Used by the cloned clipboard overlay.
  check                          Report dependencies and what paste would do now.
USAGE
}

case "${1:-}" in
paste) shift; cmd_paste "$@" ;;
paste-entry) shift; cmd_paste_entry "$@" ;;
check) shift; cmd_check "$@" ;;
-h | --help | help | "") usage ;;
*) echo "omarchy-pasteimage: unknown command: $1" >&2; usage >&2; exit 1 ;;
esac
