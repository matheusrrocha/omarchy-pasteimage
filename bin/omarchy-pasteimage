#!/bin/bash
# pasteimage — image-aware universal paste for Omarchy.
#
# Omarchy's stock "Universal paste" (SUPER+V) sends Shift+Insert whenever the
# focused window carries Hyprland's `terminal` tag. Terminals implement
# Shift+Insert as paste_from_clipboard, which is text-only, so pasting an image
# into a TUI is a silent no-op. This routes those to Ctrl+V instead, which
# terminals pass straight through to the running program — Claude Code and
# friends then read the image off the clipboard themselves.
#
# Keystrokes are injected with Hyprland's own send_key_state dispatcher rather
# than wtype: a physically-held SUPER merges into a wtype-injected chord at the
# seat, which would turn our Ctrl+V into SUPER+CTRL+V (the clipboard manager).
# See /usr/share/omarchy/default/hypr/bindings/clipboard.lua.

set -uo pipefail

# Resolved so the keybinding points at the real file even when this script is
# invoked through the ~/.local/bin symlink.
SELF=$(readlink -f "${BASH_SOURCE[0]}")
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
MARKER="$STATE_DIR/pasteimage-enabled"

# Hyprland tags terminals in default/hypr/apps/terminals.lua. Dynamic tags carry
# a trailing "*", hence the strip.
is_terminal() {
  hyprctl -j activewindow 2>/dev/null |
    jq -e '[.tags[]? | sub("\\*$"; "")] | index("terminal")' >/dev/null 2>&1
}

has_image() {
  wl-paste --list-types 2>/dev/null | grep -qE '^image/'
}

# $1=mods $2=key. The down/up split works around send_shortcut sometimes leaving
# synthetic key state stuck or repeating (hyprwm/Hyprland#14099).
send_key() {
  local mods=$1 key=$2
  hyprctl dispatch \
    "hl.dsp.send_key_state({ mods = \"$mods\", key = \"$key\", state = \"down\" })" >/dev/null
  sleep 0.05
  hyprctl dispatch \
    "hl.dsp.send_key_state({ mods = \"$mods\", key = \"$key\", state = \"up\" })" >/dev/null
}

# SUPER+V. Preserves stock behaviour everywhere except the case it exists to fix:
# a terminal holding an image, which gets Ctrl+V so the TUI can claim it.
cmd_paste() {
  if is_terminal && ! has_image; then
    send_key SHIFT Insert
  else
    send_key CTRL V
  fi
}

# Called by the cloned clipboard overlay for image rows. Puts the chosen image on
# the clipboard first, then pastes it — the sleep lets the overlay close and focus
# return to the window underneath.
cmd_paste_entry() {
  local mime=${1:-} path=${2:-}

  if [[ -z $mime || -z $path ]]; then
    echo "usage: omarchy-pasteimage paste-entry <mime-type> <path>" >&2
    return 1
  fi
  [[ -r $path ]] || { echo "omarchy-pasteimage: cannot read $path" >&2; return 1; }

  wl-copy --type "$mime" <"$path" || return 1
  sleep 0.15
  send_key CTRL V
}

shell_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }
lua_quote() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

# Installs the keybinding into Hyprland's runtime state — but only once the user
# has opted in with `enable`. Called by Service.qml at load and after every
# config reload, so a plugin that is installed but not enabled stays completely
# inert.
#
# Hyprland's Lua parser refuses `hyprctl keyword` ("keyword can't work with
# non-legacy parsers. Use eval."), so the bind goes in through `hyprctl eval`.
# The unbind matters: without it the config's own SUPER+V stays registered
# alongside this one and both fire.
#
# The exec is guarded because the binding outlives the plugin — omarchy-shell
# never destroys a service component, so there is no teardown hook. If the
# script is gone, the keypress reloads the config and hands SUPER+V straight
# back to the user's own binding instead of dying.
cmd_apply_binding() {
  [[ -e $MARKER ]] || return 0

  local exec_cmd lua
  exec_cmd="test -x $(shell_quote "$SELF") && exec $(shell_quote "$SELF") paste || hyprctl reload config-only"
  lua="hl.unbind(\"SUPER + V\") hl.bind(\"SUPER + V\", hl.dsp.exec_cmd($(lua_quote "$exec_cmd")), { description = \"Universal paste\" })"

  hyprctl eval "$lua" >/dev/null
}

cmd_enable() {
  mkdir -p "$STATE_DIR" || { echo "omarchy-pasteimage: cannot create $STATE_DIR" >&2; return 1; }
  touch "$MARKER" || return 1
  cmd_apply_binding
  echo "SUPER+V now pastes clipboard images into terminal TUIs."
  echo "Undo with: omarchy-pasteimage disable"
}

cmd_disable() {
  rm -f "$MARKER"
  # Hands SUPER+V back to the user's own config. config-only skips the monitor
  # reload, so nothing on screen flickers.
  hyprctl reload config-only >/dev/null 2>&1
  echo "SUPER+V returned to your Hyprland config."
}

cmd_check() {
  local missing=0 dep
  for dep in hyprctl jq wl-paste wl-copy; do
    if command -v "$dep" >/dev/null; then
      echo "  ok       $dep"
    else
      echo "  MISSING  $dep" >&2
      missing=1
    fi
  done

  echo
  if [[ -e $MARKER ]]; then
    echo "  opted in: yes ($MARKER)"
  else
    echo "  opted in: NO — run 'omarchy-pasteimage enable' to claim SUPER+V"
  fi

  if is_terminal; then
    echo "  focused window: terminal (would use Ctrl+V for images)"
  else
    echo "  focused window: not a terminal (always Ctrl+V)"
  fi

  local types
  types=$(wl-paste --list-types 2>/dev/null | tr '\n' ' ')
  echo "  clipboard types: ${types:-<empty>}"
  if has_image; then
    echo "  clipboard holds an image -> SUPER+V will send Ctrl+V"
  else
    echo "  clipboard holds no image -> SUPER+V pastes as usual"
  fi

  return $missing
}

usage() {
  cat <<'USAGE'
Usage: omarchy-pasteimage <command>

  enable                         Claim SUPER+V for image-aware paste. Opt-in;
                                 the plugin does nothing until you run this.
  disable                        Hand SUPER+V back to your Hyprland config.
  check                          Report opt-in state, dependencies, and what
                                 paste would do right now.
  paste                          Image-aware universal paste. Bound to SUPER+V.
  paste-entry <mime> <path>      Copy a file to the clipboard and paste it.
                                 Used by the cloned clipboard overlay.
  apply-binding                  Re-assert the binding if opted in. Called by
                                 the plugin service; not usually run by hand.
USAGE
}

case "${1:-}" in
enable) shift; cmd_enable "$@" ;;
disable) shift; cmd_disable "$@" ;;
apply-binding) shift; cmd_apply_binding "$@" ;;
paste) shift; cmd_paste "$@" ;;
paste-entry) shift; cmd_paste_entry "$@" ;;
check) shift; cmd_check "$@" ;;
-h | --help | help | "") usage ;;
*) echo "omarchy-pasteimage: unknown command: $1" >&2; usage >&2; exit 1 ;;
esac
